<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edge">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- DIAL Action for RoleManager.ROLE_DIALER compliance -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <data android:scheme="tel" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <data android:scheme="tel" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CallDetailActivity"
            android:exported="true"
            android:label="Call Details" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="Settings" />

        <activity
            android:name=".ui.NoticesActivity"
            android:exported="true"
            android:label="Open Source Notices" />

        <activity
            android:name=".ui.DialerActivity"
            android:exported="true"
            android:label="Edge Business Dialer" />

        <!-- InCallService for Telephony State & Auto-Answer -->
        <service
            android:name=".telephony.EdgeInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- CallScreeningService for Call Screening -->
        <service
            android:name=".telephony.EdgeCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Test Audio Receiver for Dynamic On-Device TTS Validation -->
        <receiver
            android:name=".telephony.TestAudioReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.edge.reception.TEST_DYNAMIC_TTS" />
            </intent-filter>
        </receiver>

        <!-- Voice Test Receiver for Local Two-Way Voice Loop over USB -->
        <receiver
            android:name=".telephony.VoiceTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.edge.reception.START_LOCAL_VOICE_TEST" />
                <action android:name="com.edge.reception.END_LOCAL_VOICE_TEST" />
            </intent-filter>
        </receiver>

        <!-- Carrier Call Receiver for Asterisk SIP / Real Telephony Calls -->
        <receiver
            android:name=".telephony.CarrierCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.edge.reception.START_CARRIER_CALL" />
                <action android:name="com.edge.reception.END_CARRIER_CALL" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
